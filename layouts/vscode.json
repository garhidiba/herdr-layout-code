{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "terminal_menu": "vscode-menu",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "vscode-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "vscode-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "floating": [
            {
              "id": "memo",
              "content": {
                "mod": "vscode-memo"
              },
              "edge": "bottom",
              "align": "end"
            }
          ],
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "vscode-pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "side",
              "type": "row",
              "size": {
                "px": 368
              },
              "min": 260,
              "max": 2108,
              "gap": 8,
              "children": [
                {
                  "id": "panel",
                  "type": "column",
                  "hidden": false,
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "explorer",
                      "children": [
                        {
                          "id": "explorer",
                          "type": "block",
                          "content": {
                            "mod": "vscode-explorer"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "vscode-scm"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "image-panel",
                  "type": "block",
                  "hidden": true,
                  "size": {
                    "px": 420
                  },
                  "min": 260,
                  "max": 1200,
                  "content": {
                    "mod": "vscode-viewer",
                    "props": {
                      "imagePanel": true
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "vscode-status"
          }
        }
      ]
    }
  ]
}